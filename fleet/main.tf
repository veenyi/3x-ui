provider "threexui" {
  endpoint               = var.panel_endpoint
  base_path              = var.panel_base_path
  username               = var.panel_username
  password               = var.panel_password
  insecure_skip_verify   = var.panel_insecure
}

# The routing text and the balancer name are NOT written here. quickstart.py
# generates them from the live subscription and emits fleet.auto.tfvars.json;
# hand-copying them into HCL is what let this file drift behind reality (the
# first version of this file silently dropped the twitter/discord rules and
# pointed OpenAI at the wrong group).
variable "clash_rules" {
  type        = string
  description = "Generated by xui-quickstart --emit-tf. Do not hand-edit."
  default     = ""
}

variable "balancer_remark" {
  type        = string
  default     = "auto-fastest"
}

resource "threexui_inbound" "primary" {
  port     = var.primary_port
  protocol = "vless"
  enable   = true
  remark   = "TechnoVMBGP Lite"

  vless_settings {
    decryption = "none"
  }

  stream_settings {
    network  = "tcp"
    security = "reality"
    reality_settings {
      target       = var.reality_target
      server_names = [split(":", var.reality_target)[0]]
    }
  }

  sniffing {
    enabled       = true
    dest_override = ["http", "tls", "quic", "fakedns"]
  }
}

resource "threexui_inbound" "fallback" {
  port     = var.fallback_port
  protocol = "vless"
  enable   = true
  remark   = "TechnoVMBGP Lite [fallback 8443]"

  vless_settings {
    decryption = "none"
  }

  stream_settings {
    network  = "tcp"
    security = "reality"
    reality_settings {
      target       = var.reality_target
      server_names = [split(":", var.reality_target)[0]]
    }
  }
}

resource "threexui_inbound_client" "primary" {
  inbound_id  = threexui_inbound.primary.id
  email       = var.client_email
  client_id   = var.client_uuid
  flow        = "xtls-rprx-vision"
  enable      = true
  total_gb    = var.total_gb
  sub_id      = var.client_sub_id
  expiry_time = 0
}

resource "threexui_inbound_client" "fallback" {
  inbound_id  = threexui_inbound.fallback.id
  email       = var.client_email
  client_id   = var.client_uuid
  flow        = "xtls-rprx-vision"
  enable      = true
  total_gb    = var.total_gb
  sub_id      = var.client_sub_id
  expiry_time = 0
}

# sing-box clients get automatic fastest-port selection from this upstream
# feature; clash clients get it from the LIVE url-test group above.
resource "threexui_sub_balancer" "auto_fastest" {
  remark      = var.balancer_remark
  strategy    = "leastPing"
  inbound_ids = [threexui_inbound.primary.id, threexui_inbound.fallback.id]
  enabled     = true
}

resource "threexui_panel_subscription" "settings" {
  sub_enable              = true
  sub_port                = 2096
  sub_clash_enable        = true
  sub_clash_path          = var.clash_path
  sub_json_enable         = true
  sub_json_path           = var.singbox_path
  sub_clash_enable_routing  = true
  sub_clash_rules         = var.clash_rules
  remark_template         = var.remark_template
}

variable "remark_template" {
  type        = string
  # The live panel shows remaining traffic and days left in every node name;
  # a bare "{{INBOUND}}-{{EMAIL}}" here would silently strip that from all
  # clients on the next apply.
  default     = "{{INBOUND}}-{{EMAIL}}|📊{{TRAFFIC_LEFT}}|⏳{{DAYS_LEFT}}D"
}
