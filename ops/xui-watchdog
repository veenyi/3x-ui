#!/usr/bin/env bash
# xui-watchdog — cheap health checks for a 3x-ui box, meant for cron.
#
# Exit 0 = all good. Non-zero = number of failed checks, and each failure is
# logged. No external alerting is wired up because this host has no Telegram /
# SMTP / Discord credentials configured; set NOTIFY_CMD to plug one in.
set -uo pipefail

LOG=/var/log/xui-watchdog.log
STATUS=/run/xui-watchdog-status
DB=/etc/x-ui/x-ui.db
CERT=/root/cert/ip/fullchain.pem
NOTIFY_CMD="${NOTIFY_CMD:-}"          # e.g. "/usr/local/bin/notify.sh %s"

fail=0
note() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" | tee -a "$LOG" >&2; }
check() { # $1 label, $2 detail
  note "FAIL  $1: $2"
  fail=$((fail+1))
}

dbval() {
  # Pass the key as argv and quote the python source in single quotes. A bare
  # `except: print('')` here once swallowed an IndexError and made every check
  # silently read an empty port, so a broken watchdog reported "ok".
  python3 -c '
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
rows = list(c.execute("select value from settings where key=?", (sys.argv[2],)))
print(rows[0][0] if rows else "")
' "$DB" "$1"
}

WEB_PORT=$(dbval webPort)
SUB_PORT=$(dbval subPort)
BASE=$(dbval webBasePath)

# --- 1. TLS certificate -------------------------------------------------
if [ -f "$CERT" ]; then
  END=$(openssl x509 -in "$CERT" -noout -enddate 2>/dev/null | cut -d= -f2)
  END_S=$(date -d "$END" +%s 2>/dev/null || echo 0)
  LEFT=$(( (END_S - $(date +%s)) / 86400 ))
  if [ "$LEFT" -lt 2 ]; then
    check cert "only ${LEFT}d left (expires ${END}); acme.sh renewal is not keeping up"
  else
    note "ok    cert ${LEFT}d left"
  fi
  # A renewed file that the running panel never loaded is the silent failure
  # mode here: compare what acme.sh deployed against what the port serves.
  FILE_FP=$(openssl x509 -in "$CERT" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2 | tr -d ':')
  LIVE_FP=$(echo | timeout 10 openssl s_client -connect "127.0.0.1:${WEB_PORT}" -servername 23.147.68.103 2>/dev/null \
            | openssl x509 -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2 | tr -d ':')
  if [ -n "$LIVE_FP" ] && [ "$FILE_FP" != "$LIVE_FP" ]; then
    check cert-reload "panel is serving a different cert than ${CERT} (restart x-ui after renewal)"
  fi
else
  check cert "$CERT missing"
fi

# --- 2. services and listeners -----------------------------------------
systemctl is-active --quiet x-ui || check service "x-ui not active"
for p in "$WEB_PORT" "$SUB_PORT"; do
  [ -n "$p" ] || continue
  ss -lnt 2>/dev/null | grep -q ":$p " || check listener "nothing listening on $p"
done
INBOUND_PORTS=$(python3 -c "
import sqlite3
print(' '.join(str(r[0]) for r in sqlite3.connect('$DB').execute('select port from inbounds where enable=1')))
")
for p in $INBOUND_PORTS; do
  ss -lnt 2>/dev/null | grep -q ":$p " || check inbound "inbound port $p is enabled in the DB but not listening"
done

# --- 2b. the reality handshake target is still handshakeable --------------
# When the destination site stops offering TLS1.3 with an X25519 group, xray
# keeps listening and behaves normally to the panel while every client fails
# the handshake. That looks exactly like our own outage, so check the target.
TARGETS=$(python3 -c "
import json, sqlite3
seen, out = set(), []
for (ss,) in sqlite3.connect('$DB').execute('select stream_settings from inbounds where enable=1'):
    try:
        d = json.loads(ss or '{}')
    except Exception:
        continue
    # the column holds the streamSettings object itself, but an inbound saved
    # through the API can arrive wrapped; accept both shapes
    for cand in (d, d.get('streamSettings') or {}):
        rs = (cand or {}).get('realitySettings') or {}
        t = rs.get('target')
        if t and ':' in t and t not in seen:
            seen.add(t); out.append(t)
print(' '.join(out))
")
for t in $TARGETS; do
  h=${t%%:*}; p=${t##*:}
  case "$p" in *[!0-9]*) p=443 ;; esac
  if ! echo | timeout 15 openssl s_client -connect "$h:$p" -servername "$h" -tls1_3 2>&1 \
       | grep -qiE 'TLS1\.3 group:.*X25519|Protocol: TLSv1\.3'; then
    check reality_target "$t no longer completes a TLS1.3/X25519 handshake; clients will fail"
  else
    note "ok    reality target $t still handshakes"
  fi
done

# --- 3. subscription actually yields a usable node ----------------------
SUB_ID=$(python3 -c "
import sqlite3
r=list(sqlite3.connect('$DB').execute('select sub_id from clients where enable=1 limit 1'))
print(r[0][0] if r else '')
")
CLASH_PATH=$(dbval subClashPath)
if [ -n "$SUB_ID" ]; then
  # 3x-ui builds each node's `server` from the request Host header. Probing via
  # 127.0.0.1 therefore yields `server: localhost` and would look like a broken
  # subscription when it is not. Send the address real clients use.
  PUBIP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1)}' | head -1)
  [ -n "$PUBIP" ] || PUBIP=$(hostname -I 2>/dev/null | awk '{print $1}')
  SUB_TLS=$(dbval subCertFile)
  SCHEME=$([ -n "$SUB_TLS" ] && echo https || echo http)
  URL="${SCHEME}://${PUBIP:-127.0.0.1}:${SUB_PORT}${CLASH_PATH%/}/${SUB_ID}"
  # One verdict, from parsing the profile rather than grepping it: the fleet
  # publisher puts `proxies` first and a provider block after, so any
  # line-anchored match is layout-sensitive, and a grep-only probe used to
  # report FAIL and "ok N node(s)" for the same response.
  PROBE=$(python3 - "$URL" <<'PYEOF'
import json, ssl, sys, time, urllib.request
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
err = "no-response"
body = ""
for _ in range(6):
    try:
        r = urllib.request.Request(sys.argv[1], headers={"User-Agent": "clash/1.18.0"})
        body = urllib.request.urlopen(r, timeout=20, context=ctx).read().decode("utf-8", "replace")
        err = ""
        break
    except Exception as e:
        err = str(e)[:70]
    time.sleep(5)
if err:
    print(json.dumps({"fail": "unreachable: %s" % err}))
    raise SystemExit
try:
    import yaml
except ImportError:
    print(json.dumps({"nodes": body.count("\n- ")}))
    raise SystemExit
doc = yaml.safe_load(body) or {}
proxies = doc.get("proxies") or []
providers = list((doc.get("proxy-providers") or {}))
groups = doc.get("proxy-groups") or []
# a group can embed proxy mappings instead of referencing them by name; those
# are definitions, and testing a dict for set membership raises TypeError,
# which used to abort the probe while the script still printed "ok"
inline = [m for g in groups for m in (g.get("proxies") or []) if isinstance(m, dict)]
names = ({p.get("name") for p in proxies} | {m.get("name") for m in inline}
         | {g.get("name") for g in groups}
         | set(providers) | {"DIRECT", "REJECT", "PASS"})
out = {"nodes": len(proxies), "groups": len(groups),
       "providers": ",".join(providers) or "-"}
loop = [p.get("name") for p in proxies
        if str(p.get("server", "")).startswith(("127.", "localhost", "::1"))]
dangling = ["%s->%s" % (g.get("name"), m) for g in groups
            for m in (g.get("proxies") or [])
            if isinstance(m, str) and m not in names]
bad_use = [p for g in groups for p in (g.get("use") or []) if p not in providers]
if loop:
    out["fail"] = "loopback server in %s" % loop[:4]
elif dangling:
    out["fail"] = "dangling members %s" % dangling[:4]
elif bad_use:
    out["fail"] = "use() names undeclared provider %s" % bad_use[:4]
elif not proxies and not providers:
    out["fail"] = "profile has neither proxies nor providers"
print(json.dumps(out))
PYEOF
)
  FAIL=$(printf '%s' "$PROBE" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("fail",""))' 2>/dev/null)
  INFO=$(printf '%s' "$PROBE" | python3 -c 'import json,sys;d=json.load(sys.stdin);print("%s nodes, %s groups, providers=%s"%(d.get("nodes","?"),d.get("groups","?"),d.get("providers","-")))' 2>/dev/null)
  if [ -n "$FAIL" ]; then
    check subscription "${INFO}; ${FAIL} at ${URL}"
  else
    note "ok    subscription ${INFO} via ${URL}"
  fi
fi

# --- 4. regression guard for the fork's sponsor patch ------------------
# If this ever returns a sponsor, the running binary is not our build (an
# accidental `x-ui update` from upstream, most likely).
# webBasePath already carries a trailing slash; appending "/sponsors" would
# produce a double slash and a 404.
SP=$(curl -sk -m 15 "https://127.0.0.1:${WEB_PORT}${BASE%/}/sponsors" 2>/dev/null)
if echo "$SP" | grep -q '"sponsors":\[\]'; then
  note "ok    sponsors suppressed"
else
  check sponsor "endpoint did not return an empty list: ${SP:0:120}"
fi

printf '%s\n' "$fail" > "$STATUS"
if [ "$fail" -gt 0 ]; then
  note "SUMMARY $fail check(s) failed"
  if [ -n "$NOTIFY_CMD" ]; then
    printf 'x-ui watchdog: %s failures on %s\n' "$fail" "$(hostname)" | "$NOTIFY_CMD" /dev/stdin || true
  fi
else
  note "SUMMARY all checks passed"
fi
exit "$fail"
