#!/usr/bin/env python3
"""xui-fleet-sync — make THIS panel's clash subscription carry the whole fleet.

Run it on the front node (cron: every 6 hours). Each source is read by
whichever transport actually reaches it:

  local   the panel's own subscription over 127.0.0.1
  url     a sibling panel's subscription port, when it is reachable
  ssh     a forced, read-only subscription reader -- required for hosts whose
          provider filters every inbound port but 22/443, where :2096 is dark

Two things this has to get right, and neither is obvious from the panel UI:

1. mergeClashRulesYAML merges only `rules` and ASSIGNS every other top-level
   key over the generated config. So `proxies` must be restated in full (own
   nodes included) and every group member must actually be defined, or mihomo
   refuses the profile with "dial name ... not found".
2. Sibling panels collide: two freshly quickstarted boxes both name their
   fallback "Reality-443 [fallback 8443]". Names are labels, so the loser gets
   prefixed by its source; keys and ports stay untouched.

The upstream subscription is declared as a proxy-provider, not copied: its
endpoint answers 403 to overseas IPs, so the VPS can never fetch it, while a
mihomo client on the user's own network can -- which is how OpenClash keeps
providers fresh without the server being able to reach them.
"""
import argparse
import json
import re
import ssl
import subprocess
import sys
import time
import urllib.request

DB = "/etc/x-ui/x-ui.db"
MANIFEST = "/etc/x-ui/fleet.json"
LOG = "/var/log/xui-fleet.log"

SERVICE_GROUPS = [
    ("OpenAI", ["openai.com", "chatgpt.com", "oaistatic.com",
                "oaiusercontent.com", "anthropic.com", "claude.ai"]),
    ("Google", ["google.com", "googleapis.com", "gstatic.com",
                "googleusercontent.com"]),
    ("YouTube", ["youtube.com", "youtu.be", "ytimg.com", "googlevideo.com"]),
    ("Telegram", ["telegram.org", "t.me", "telegram.me"]),
    ("Streaming", ["netflix.com", "nflxvideo.net", "disneyplus.com",
                   "spotify.com", "twitch.tv"]),
    ("AI", ["copilot.microsoft.com", "gemini.google.com", "perplexity.ai"]),
]


def note(msg):
    line = "%s %s" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), msg)
    print(line)
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def ctx_noverify():
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def detect_public_ip():
    for probe in ("https://api.ipify.org", "https://ifconfig.me/ip"):
        try:
            return urllib.request.urlopen(probe, timeout=10).read().decode().strip()
        except Exception:
            continue
    return ""


def read_local(retries=8):
    """Own subscription, addressed by public IP so `server:` is not localhost.

    A restart brings the panel listener up first and the subscription listener
    seconds later; reading immediately produced "connection refused" and left
    the settings written but unverified.
    """
    import sqlite3
    c = sqlite3.connect(DB)
    d = dict((str(k), str(v)) for k, v in c.execute("select key,value from settings"))
    sub = list(c.execute("select sub_id from clients where enable=1 limit 1"))[0][0]
    scheme = "https" if d.get("subCertFile") else "http"
    url = "%s://127.0.0.1:%s%s%s" % (scheme, d["subPort"], d["subClashPath"], sub)
    last = None
    for _ in range(retries):
        try:
            r = urllib.request.Request(url)
            r.add_header("Host", "%s:%s" % (detect_public_ip(), d["subPort"]))
            r.add_header("User-Agent", "clash/1.18.0")
            return urllib.request.urlopen(r, timeout=30, context=ctx_noverify()).read().decode("utf-8")
        except Exception as e:
            last = e
            time.sleep(3)
    raise RuntimeError("subscription not served yet: %s" % last)


def read_url(url):
    r = urllib.request.Request(url, headers={"User-Agent": "clash/1.18.0"})
    return urllib.request.urlopen(r, timeout=30, context=ctx_noverify()).read().decode("utf-8")


def read_ssh(src):
    """Forced-command reader; the remote end ignores argv, so nothing else can
    be asked of it."""
    cmd = ["ssh", "-i", src["key"], "-o", "BatchMode=yes",
           "-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=15",
           "-p", str(src.get("port", 22)), "%s@%s" % (src.get("user", "root"), src["host"])]
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    if "=CLASH=" not in out.stdout:
        raise RuntimeError("ssh %s: %s" % (src["host"], (out.stderr or out.stdout)[:150]))
    return out.stdout.split("=CLASH=")[-1].split("=LINKS=")[0]


NAME_RE = r"(?m)^\s*(?:-\s+)?name:\s*(.+?)\s*$"


def name_of(block):
    # The `- ` must be allowed: yaml.safe_dump keeps dict order, and an
    # upstream proxy starts with `- name: ...` on the first line. Without this
    # the 90 upstream nodes all read as nameless and were dropped silently.
    m = re.search(NAME_RE, block)
    return m.group(1).strip().strip("'\"") if m else None


def set_name(block, new):
    """Rename via parse+dump, never by regex substitution.

    Upstream names carry colons and pipes ("Traffic: 31.28 GB | 1000 GB");
    writing one unquoted produced invalid YAML, the panel's parser rejected the
    entire rules blob and silently served its own 2-node config instead --
    which looked like the upstream had vanished.
    """
    try:
        import yaml
        items = yaml.safe_load(block)
        if isinstance(items, list) and items and isinstance(items[0], dict):
            items[0]["name"] = new
            return yaml.safe_dump(items, allow_unicode=True, sort_keys=False,
                                  width=10 ** 6).rstrip("\n")
    except Exception:
        pass
    return re.sub(r"(?m)^(\s*(?:-\s+)?name:).*$", r"\g<1> '%s'" % new.replace("'", "''"),
                  block, count=1)


def proxy_blocks(text):
    """Return each proxy as its own YAML block, dash at column 0.

    Parsed rather than regex-split: panel output is block style at column 0,
    but an exported clash profile writes flow-style items with indentation
    (`  - {name: ..., server: ...}`), which a `^- ` scan silently drops --
    that is how the upstream's 90 nodes would vanish without any error.
    """
    head = text.split("proxy-groups:")[0] if "proxy-groups:" in text else text
    try:
        import yaml
        doc = yaml.safe_load(head) or {}
        px = doc.get("proxies") or []
        return [yaml.safe_dump([p], allow_unicode=True, sort_keys=False,
                               default_flow_style=False, width=10 ** 6).rstrip("\n")
                for p in px if isinstance(p, dict) and p.get("name") and p.get("server")]
    except Exception:
        pass
    blocks = []
    for b in re.split(r"\n(?=- )", "\n" + head.strip()):
        b = b.strip("\n")
        if b.startswith("- ") and name_of(b) and "server:" in b:
            blocks.append(b)
    return blocks


def read_file(path):
    """Upstream nodes from an exported clash profile on this host.

    Provider mode is nicer, but it only works while the upstream URL actually
    serves nodes: huacloud answered 400 "The following link doesn't contain any
    valid node" and the inner xmancdn link 404/403, which left the client with
    a broken provider and a profile it could not load. Inlining keeps the
    subscription self-contained; refresh by re-copying the file.
    """
    return open(path, encoding="utf-8").read()


def scalar(item, indent="    - "):
    """Emit one YAML sequence item, quoted exactly as the scalar needs.

    Group members are names, and upstream names contain colons
    ("Traffic: 31.28 GB | 1000 GB"). Writing those bare makes YAML read them as
    a mapping, and mihomo then refuses the group:
    `ProxyGroup 上游订阅: 'proxies[0]' expected type 'string', got unconvertible
    type 'map[string]interface {}'`.
    """
    try:
        import yaml
        dumped = yaml.safe_dump(item, default_flow_style=True, width=10 ** 6,
                                allow_unicode=True)   # keep 中文/emoji readable in the UI
        # a bare scalar is dumped as `value` plus a `...` document-end marker;
        # keeping that marker makes the surrounding mapping invalid YAML
        body = [l for l in dumped.split("\n") if l.strip() not in ("", "...", "---")]
        return indent + " ".join(body).strip()
    except Exception:
        return indent + '"%s"' % str(item).replace("\\", "\\\\").replace('"', '\\"')


def name_line(value, indent="- "):
    """`- name: <value>` with the value quoted only when it needs to be."""
    return "%sname: %s" % (indent, scalar(value, "").strip())


def build_rules(entries, providers, region, up_names=None):
    lines = []
    # A header the panel UI can actually show. The upstream lives only in this
    # text blob -- the panel's own "outbound subscriptions" list is unusable for
    # it because that feature fetches server-side and the provider geo-fences
    # its endpoint -- so without these lines the URL is invisible to anyone who
    # opens 面板设置 → 订阅设置 → Clash 自定义规则.
    lines.append("# 由 xui-fleet-sync 生成，请勿手改（下次同步会覆盖）。")
    lines.append("# 自建节点已内联在下方 proxies:。")
    active = [p for p in providers if p.get("enabled", True)]
    for p in providers:
        lines.append("# 上游 %-10s %s  url: %s" % (
            p["name"],
            ("provider 模式，刷新 %ss" % p.get("interval", 3600)) if p.get("enabled", True)
            else "已内联（源头当前拉不到，恢复后把 fleet.json 的 enabled 改回 true）",
            p["url"]))
    lines.append("proxies:")
    lines += [e["block"] for e in entries]

    if active:
        lines.append("proxy-providers:")
        for p in active:
            lines += ["  %s:" % p["name"],
                      "    type: http",
                      "    url: %s" % p["url"],
                      "    interval: %d" % p.get("interval", 3600),
                      "    path: ./proxy_provider/%s.yaml" % p["name"],
                      "    format: yaml",
                      # mihomo declares header as []string of "Key: Value", not a
                      # mapping. A map here makes the whole profile fail to load:
                      # "parse proxy provider flower error: 'header[User-Agent]'
                      # is not a slice" (seen in FlClash on 2026-11-16).
                      "    header:",
                      '      - "User-Agent: clash/1.18.0"',
                      "    health-check:",
                      "      enable: true",
                      "      url: http://www.gstatic.com/generate_204",
                      "      interval: 600",
                      "      timeout: 5"]

    names = [e["name"] for e in entries]
    self_names = [e["name"] for e in entries if e.get("role") != "upstream"]
    up_names = list(up_names or []) + [e["name"] for e in entries if e.get("role") == "upstream"]
    groups = []
    if len(self_names) > 1:
        # url-test only over our own ports: an upstream ss node on another
        # provider's host would be pinged and rotated by us, and its latency
        # has nothing to do with which of our Reality ports is best
        groups.append([name_line("LIVE"), "  type: url-test", "  proxies:"] +
                      [scalar(n) for n in self_names] +
                      ["  url: http://www.gstatic.com/generate_204",
                       "  interval: 300", "  tolerance: 50", "  lazy: true"])
    if active or up_names:
        grp = [name_line("上游订阅"), "  type: select"]
        if active:
            grp += ["  use:"] + [scalar(p["name"]) for p in active]
        members = [scalar(n) for n in (up_names or [])] or [scalar("DIRECT")]
        grp += ["  proxies:"] + members
        groups.append(grp)
    proxy_members = (["LIVE"] if len(self_names) > 1 else []) + self_names + \
                    (["上游订阅"] if (active or up_names) else []) + ["DIRECT"]
    groups.append([name_line("PROXY"), "  type: select", "  proxies:"] +
                  [scalar(m) for m in proxy_members])
    groups.append([name_line(region), "  type: select", "  proxies:",
                   scalar("PROXY"), scalar("DIRECT")])
    for gname, _ in SERVICE_GROUPS:
        groups.append([name_line(gname), "  type: select", "  proxies:",
                       scalar("PROXY"), scalar(region), scalar("DIRECT")])
    groups.append([name_line("Final"), "  type: select", "  proxies:",
                   scalar("PROXY"), scalar("DIRECT")])
    lines.append("proxy-groups:")
    for g in groups:
        lines += g

    rules = []
    for gname, domains in SERVICE_GROUPS:
        rules += ["- DOMAIN-SUFFIX,%s,%s" % (d, gname) for d in domains]
    rules += ["- DOMAIN-SUFFIX,github.com,PROXY", "- DOMAIN-SUFFIX,githubusercontent.com,PROXY",
              "- DOMAIN-SUFFIX,wikipedia.org,PROXY", "- DOMAIN-SUFFIX,x.com,PROXY",
              "- DOMAIN-SUFFIX,twitter.com,PROXY", "- DOMAIN-SUFFIX,discord.com,PROXY",
              "- DOMAIN-SUFFIX,discordapp.net,PROXY", "- GEOIP,CN,DIRECT", "- MATCH,Final"]
    lines.append("rules:")
    lines += rules
    return "\n".join(lines) + "\n"


def verify(served_text, provider_names):
    """Return group members that resolve to nothing.

    Parsing beats regex: the fork writes url-test groups as a sequence of
    mappings, so a line-based scan mistook `interval: 300` for a node name.
    """
    try:
        import yaml
    except ImportError:
        return []
    doc = yaml.safe_load(served_text)
    defined = {p.get("name") for p in (doc.get("proxies") or [])}
    for g in doc.get("proxy-groups") or []:
        defined.add(g.get("name"))
    # members pulled in by `use:` come from providers, resolved at the client
    for g in doc.get("proxy-groups") or []:
        for p in g.get("use") or []:
            defined.add(p)
    defined |= set(provider_names) | {"DIRECT", "REJECT", "PASS"}
    bad = []
    for g in doc.get("proxy-groups") or []:
        for i, m in enumerate(g.get("proxies") or []):
            if not isinstance(m, str):
                # mihomo: "proxies[i] expected type 'string'" -- a colon-bearing
                # name emitted bare turns into a mapping and breaks the load
                bad.append("%s[%d] not a string" % (g.get("name"), i))
            elif m not in defined:
                bad.append("%s->%s" % (g.get("name"), m))
    n = len(doc.get("proxies") or [])
    note("ok    served %d proxy(ies), %d group(s), %d provider(s)"
         % (n, len(doc.get("proxy-groups") or []), len(doc.get("proxy-providers") or {})))
    return bad


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--manifest", default=MANIFEST)
    args = ap.parse_args()

    man = json.load(open(args.manifest, encoding="utf-8"))
    entries, taken = [], set()
    for src in man["sources"]:
        try:
            reader = {"local": read_local, "url": lambda: read_url(src["url"]),
                      "ssh": lambda: read_ssh(src),
                      "file": lambda: read_file(src["path"])}[src["kind"]]
            text = reader()
        except KeyError:
            note("warn  %-10s unknown kind %r" % (src["name"], src["kind"]))
            continue
        except Exception as e:
            note("warn  %-10s skipped: %s" % (src["name"], str(e)[:90]))
            continue
        blocks = proxy_blocks(text)
        # Ownership filter. Without it the front node reads back the siblings
        # it published into its own subscription last run and re-adds them with
        # a prefix, so the node list doubles every execution (6 -> 10 -> ...).
        # Upstream sources are exempt: their servers are not ours by design.
        own = "" if src.get("role") == "upstream" else (
            src.get("ip") or (detect_public_ip() if src["kind"] == "local" else ""))
        if own:
            mine = [b for b in blocks
                    if re.search(r"(?m)^\s*server:\s*[\"']?%s\s*$" % re.escape(own), b)]
            if mine:
                if len(mine) != len(blocks):
                    note("ok    %-10s dropped %d foreign node(s) it published earlier"
                         % (src["name"], len(blocks) - len(mine)))
                blocks = mine
        unnamed = 0
        for blk in blocks:
            nm = name_of(blk)
            if not nm:
                unnamed += 1
                continue
            if nm in taken:
                nm = "%s %s" % (src["name"], nm)
            taken.add(nm)
            entries.append({"name": nm, "block": set_name(blk, nm),
                            "role": src.get("role", "selfbuilt")})
        note("ok    %-10s %d node(s) via %s%s%s"
             % (src["name"], len(blocks) - unnamed, src["kind"],
                " [upstream]" if src.get("role") == "upstream" else "",
                "  WARN dropped %d unnamed" % unnamed if unnamed else ""))

    rules = build_rules(entries, man.get("providers", []), man.get("region", "自建"))

    # Never hand the panel something it cannot parse: an invalid blob makes it
    # fall back to its own config with no error anywhere in the API response.
    try:
        import yaml
        parsed = yaml.safe_load(rules)
        n_prox = len((parsed or {}).get("proxies") or [])
        if n_prox != len(entries):
            note("abort %d entries built but only %d proxies parsed; refusing to publish"
                 % (len(entries), n_prox))
            return 2
        # mihomo requires every group member to be a string; a colon-bearing
        # name written bare becomes a mapping and the client rejects the group
        # outright, so catch it here instead of shipping a broken profile.
        non_str = ["%s[%d]" % (g.get("name"), i)
                   for g in (parsed or {}).get("proxy-groups") or []
                   for i, m in enumerate(g.get("proxies") or [])
                   if not isinstance(m, str)]
        if non_str:
            note("abort group members are not strings: %s" % non_str[:5])
            return 2
    except ImportError:
        pass
    except Exception as e:
        note("abort generated rules are not valid YAML: %s" % str(e)[:160])
        return 2

    import sqlite3
    c = sqlite3.connect(DB)
    d = dict((str(k), str(v)) for k, v in c.execute("select key,value from settings"))
    base = "%s://127.0.0.1:%s%s" % ("https" if d.get("webCertFile") else "http",
                                    d["webPort"], d["webBasePath"].rstrip("/"))
    tok = [l.split("=", 1)[1].strip() for l in open("/etc/x-ui/install-result.env")
           if l.startswith("XUI_API_TOKEN")][0]

    def api(path, data=None):
        body = json.dumps(data).encode() if data is not None else None
        r = urllib.request.Request(base + path, data=body,
                                   method="POST" if body is not None else "GET")
        r.add_header("Authorization", "Bearer " + tok)
        r.add_header("Content-Type", "application/json")
        with urllib.request.urlopen(r, timeout=90, context=ctx_noverify()) as x:
            return json.loads(x.read())

    eff = api("/panel/api/setting/all", {})["obj"]
    if (eff.get("subClashRules") or "").strip() == rules.strip():
        note("ok    fleet already published (%d nodes, %d providers)"
             % (len(entries), len(man.get("providers", []))))
        return 0
    if args.dry_run:
        print(rules)
        note("would publish %d nodes, %d providers (%d bytes)"
             % (len(entries), len(man.get("providers", [])), len(rules)))
        return 0

    eff["subClashEnableRouting"] = True
    eff["subClashRules"] = rules
    api("/panel/api/setting/update", eff)
    subprocess.run(["systemctl", "restart", "x-ui"], check=True)
    for _ in range(30):
        try:
            urllib.request.urlopen(urllib.request.Request(base), timeout=5,
                                   context=ctx_noverify()).read()
            break
        except Exception:
            time.sleep(2)

    served = read_local()
    dangling = verify(served, [p["name"] for p in man.get("providers", [])])
    note("change published: providers=%s, dangling=%s"
         % (",".join(p["name"] for p in man.get("providers", [])) or "-",
            dangling or "none"))
    return 1 if dangling else 0


if __name__ == "__main__":
    sys.exit(main())
